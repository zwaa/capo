{
  "name": "capo-prototype",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "artifact": "npm run build && node scripts/artifact.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "sim": "CAPO_AUTOPLAY=1 vite-node scripts/autoplay.ts --",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/node": "^22.10.1",
    "eslint": "9.15.0",
    "eslint-config-prettier": "9.1.0",
    "globals": "15.12.0",
    "prettier": "3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.15.0",
    "vite": "^5.4.11",
    "vite-node": "^2.1.8",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  }
}
