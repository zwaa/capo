# Everything text checks out with LF on every platform (including Windows),
# so Prettier, shell scripts and the Linux dev container all agree.
* text=auto eol=lf

# Binary files: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.mp3 binary
*.ogg binary
*.wav binary
